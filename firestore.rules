rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('role', '') == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         userDoc(request.auth.uid).role == 'admin')
      );
    }

    // Officer profiles. A user may read their own profile; only admins may change roles.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'officer';
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Screenings are the audit trail: append-only for officers, never deletable from the client.
    match /screenings/{id} {
      allow read: if signedIn() && (resource.data.officerId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.officerId == request.auth.uid;
      // Officers may only record their decision on their own screening; module outputs are immutable.
      allow update: if signedIn() && resource.data.officerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['decision', 'decisionNote', 'decidedAt', 'status', 'updatedAt']);
      allow delete: if false;
    }

    match /checkpoints/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
