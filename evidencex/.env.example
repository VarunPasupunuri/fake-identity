# ─────────────────────────────────────────────────────────────────────────────
# EvidenceX — copy to .env and fill in. Two keys are required to run research.
# ─────────────────────────────────────────────────────────────────────────────

# ---- LLM (the reasoning layer) ----------------------------------------------
# Provider: anthropic | openai | openai_compatible | ollama
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional. Defaults: anthropic -> claude-sonnet-5, openai -> gpt-4o-mini
LLM_MODEL=
# Optional. Only needed for openai_compatible (Groq, OpenRouter, Together, vLLM...)
LLM_BASE_URL=

# ---- Web search (the retrieval layer) ---------------------------------------
# Engine: tavily | brave | serper | searxng | duckduckgo
#   tavily / brave / serper -> need SEARCH_API_KEY (recommended, reliable)
#   searxng                 -> needs SEARCH_BASE_URL pointing at your instance
#   duckduckgo              -> keyless real search, but rate-limited and often
#                              blocked. Fine for a smoke test, not for a demo.
# EvidenceX never fabricates search results. With no working provider it
# returns a setup error instead.
SEARCH_ENGINE=tavily
SEARCH_API_KEY=
SEARCH_BASE_URL=

# ---- Agent limits (safe defaults; raise only if you have quota) --------------
MAX_SEARCH_ROUNDS=4
MAX_SOURCES=12
MAX_CANDIDATES=20
MAX_QUERIES_PER_ROUND=4
MAX_RESULTS_PER_QUERY=8

# ---- Page retrieval ----------------------------------------------------------
PAGE_TIMEOUT_SECONDS=20
PAGE_MAX_CHARS=60000
# Honour robots.txt when fetching sources. Leave true.
RESPECT_ROBOTS=true

# ---- API ---------------------------------------------------------------------
CORS_ORIGINS=*
