# ---- Firebase web config (Project settings > General > Your apps) ----
# Leave these blank to run the app in DEMO MODE (no Firebase; local auth + localStorage persistence).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the web app at local Firebase emulators (true/false)
VITE_USE_EMULATORS=false

# ---- Supabase Storage (document + live images; replaces Firebase Storage so no Blaze plan is needed) ----
# Supabase Dashboard > Project Settings > API: "Project URL" and the "anon public" key.
# The anon key is safe to ship to the browser ONLY because the bucket is private and guarded by RLS policies
# (see supabase/storage-policies.sql). Never put the service_role key here.
# Leave blank in demo mode. If Firebase is configured but these are blank, images are stored inline in Firestore
# with a warning (testing only).
VITE_SUPABASE_URL=https://vjgczydfyiavacypdaoc.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZqZ2N6eWRmeWlhdmFjeXBkYW9jIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkwNTI5NDMsImV4cCI6MjEwNDYyODk0M30.je_sMRRKmVcYTZlE5dl_wFPSFkyi_B9_znAjsq7-GPE
# Must equal the bucket id used in supabase/storage-policies.sql (public.screening_bucket()).
VITE_SUPABASE_STORAGE_BUCKET=fake

# ---- Module providers (each module is swappable without touching the UI) ----
# OCR:       mock | tesseract (in-browser) | cloud (Cloud Function -> Google Cloud Vision)
VITE_OCR_PROVIDER=tesseract
# Tampering: mock | local (in-browser ELA + EXIF) | cloud (Cloud Function ELA + EXIF via sharp)
VITE_TAMPER_PROVIDER=local
# Face:      mock | faceapi (in-browser face-api.js)
VITE_FACE_PROVIDER=faceapi
# Where face-api.js model weights are served from (default: self-hosted /models, copied by scripts/copy-assets.mjs)
VITE_FACE_MODELS_URL=

# Checkpoint identifier shown on screenings created from this device
VITE_CHECKPOINT_ID=CP-DEMO-01
