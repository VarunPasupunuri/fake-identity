rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // screenings/{uid}/{screeningId}/{document|live}.jpg
    match /screenings/{uid}/{screeningId}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.get('role', '') == 'admin');
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
